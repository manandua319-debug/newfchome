{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "fchome-472b6",
          "appId": "1:788634060832:android:4ee2899db4543b3f855445",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "fchome-472b6",
          "appId": "1:788634060832:ios:64a7a6005104de22855445",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "fchome-472b6",
          "configurations": {
            "android": "1:788634060832:android:4ee2899db4543b3f855445",
            "ios": "1:788634060832:ios:64a7a6005104de22855445",
            "web": "1:788634060832:web:2f378b223706ce53855445"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "codebase": "fchome",
      "source": "fchome",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
